include("${SR_TESTS_SOURCE_DIR}/helpers/SRTest.cmake")
sr_test_init(DESCRIPTION "Uses direct and expanded ComSpec paths, including an executable path containing spaces.")
if(NOT DEFINED ENV{ComSpec} OR "$ENV{ComSpec}" STREQUAL "")
    message(FATAL_ERROR "Windows ComSpec environment variable is not available to the test.")
endif()
string(TOUPPER "$ENV{ComSpec}" explicit_comspec)
sr_run(r ENV "ComSpec=${explicit_comspec}" ARGS --debug "${SR_OK}")
sr_assert_exit(r 0)
sr_assert_stdout_contains(r "${SR_TEST_CHILD_STDOUT_MARKER}")
sr_assert_stderr_contains(r "fullCmdLine=\"${explicit_comspec}\"")
set(spaced_comspec_dir "${SR_TEST_ROOT}/ComSpec with spaces")
file(MAKE_DIRECTORY "${spaced_comspec_dir}")
file(COPY "$ENV{ComSpec}" DESTINATION "${spaced_comspec_dir}")
get_filename_component(comspec_filename "$ENV{ComSpec}" NAME)
set(spaced_comspec "${spaced_comspec_dir}/${comspec_filename}")
file(TO_NATIVE_PATH "${spaced_comspec}" spaced_comspec_native)
sr_run(spaced ENV "ComSpec=${spaced_comspec_native}" ARGS --debug "${SR_OK}")
sr_assert_exit(spaced 0)
sr_assert_stdout_contains(spaced "${SR_TEST_CHILD_STDOUT_MARKER}")
sr_assert_stderr_contains(spaced "fullCmdLine=\"${spaced_comspec_native}\"")
# Expand ComSpec once, then pass its resolved path to the child.
sr_run(expanded
    ENV "SR_D4_COMSPEC_PATH=${spaced_comspec_native}" "ComSpec=%SR_D4_COMSPEC_PATH%"
    ARGS --debug "${SR_OK}"
)
sr_assert_exit(expanded 0)
sr_assert_stdout_contains(expanded "${SR_TEST_CHILD_STDOUT_MARKER}")
sr_assert_stderr_contains(expanded "fullCmdLine=\"${spaced_comspec_native}\"")
