@echo off
> "%~dp0hook-env.tmp" (
    echo EXIT_CODE=[%SILENTRUNNER_EXIT_CODE%]
    echo PREPARE_EXIT_CODE=[%SILENTRUNNER_PREPARE_EXIT_CODE%]
    echo RUNTIME_EXIT_CODE=[%SILENTRUNNER_RUNTIME_EXIT_CODE%]
    echo ABORTED_ON_RUNTIME_FAILURE=[%SILENTRUNNER_ABORTED_ON_RUNTIME_FAILURE%]
    echo EXECUTION_ID=[%SILENTRUNNER_EXECUTION_ID%]
    echo OUTPUT_WRITE_FAILURES=[%SILENTRUNNER_OUTPUT_WRITE_FAILURES%]
    echo STDOUT_LOG=[%SILENTRUNNER_STDOUT_LOG%]
    echo STDOUT_JSONL_LOG=[%SILENTRUNNER_STDOUT_JSONL_LOG%]
    echo STDOUT_RAW_LOG=[%SILENTRUNNER_STDOUT_RAW_LOG%]
    echo STDERR_LOG=[%SILENTRUNNER_STDERR_LOG%]
    echo STDERR_JSONL_LOG=[%SILENTRUNNER_STDERR_JSONL_LOG%]
    echo STDERR_CHILD_LOG=[%SILENTRUNNER_STDERR_CHILD_LOG%]
    echo STDERR_CHILD_JSONL_LOG=[%SILENTRUNNER_STDERR_CHILD_JSONL_LOG%]
    echo STDERR_CHILD_RAW_LOG=[%SILENTRUNNER_STDERR_CHILD_RAW_LOG%]
    echo STDERR_SR_LOG=[%SILENTRUNNER_STDERR_SR_LOG%]
    echo STDERR_SR_JSONL_LOG=[%SILENTRUNNER_STDERR_SR_JSONL_LOG%]
    echo STDERR_INCL_STDOUT_LOG=[%SILENTRUNNER_STDERR_INCL_STDOUT_LOG%]
    echo STDERR_INCL_STDOUT_JSONL_LOG=[%SILENTRUNNER_STDERR_INCL_STDOUT_JSONL_LOG%]
)
move /y "%~dp0hook-env.tmp" "%~dp0hook-env.txt" >nul
exit /b 0
