include("${SR_TESTS_SOURCE_DIR}/helpers/SRTest.cmake")
sr_test_init(DESCRIPTION "Emits child stdout in Headered and Raw stream presentation when the child succeeds.")
sr_run(r ARGS --stdout-emit stream "${SR_STDOUT_CMD}")
sr_assert_exit(r 0)
sr_assert_stdout_txt_header(r "CHILDSTDOUT")
sr_assert_stdout_occurrence_count(r "${SR_TEST_CHILD_STDOUT_MARKER}" 1)
sr_assert_stdout_not_contains(r "${SR_TEST_CHILD_STDERR_MARKER}")
sr_assert_stdout_not_contains(r "${SR_TEST_SRDIAG_TXT_PREFIX}")
set(expected_raw "${SR_TEST_ROOT}/expected-stdout-raw.bin")
set(actual_raw "${SR_TEST_ROOT}/actual-stdout-raw.bin")
sr_write_crlf_terminated_fixture("${expected_raw}" "${SR_TEST_CHILD_STDOUT_MARKER}")
sr_run(raw OUTPUT_FILE "${actual_raw}" ARGS --stdout-emit-raw stream "${SR_STDOUT_CMD}")
sr_assert_exit(raw 0)
sr_assert_files_equal_bytes("${actual_raw}" "${expected_raw}")
