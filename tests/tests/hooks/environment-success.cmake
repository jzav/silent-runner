include("${SR_TESTS_SOURCE_DIR}/helpers/SRTest.cmake")
sr_test_init(DESCRIPTION "Exposes successful exit code and execution ID to the success hook environment.")
sr_run(r ARGS --debug --id-base ctest-hook-success --run-on-success hook-env.cmd "${SR_OK}")
sr_assert_exit(r 0)
sr_assert_stderr_contains(r "SILENTRUNNER_PREPARE_EXIT_CODE=0")
sr_assert_stderr_contains(r "SILENTRUNNER_RUNTIME_EXIT_CODE=0")
sr_assert_stderr_contains(r "SILENTRUNNER_EXIT_CODE=0")
sr_assert_stderr_contains(r "SILENTRUNNER_ABORTED_ON_RUNTIME_FAILURE=false")
set(env_file "${SR_TEST_ROOT}/hook-env.txt")
sr_wait_for_path("${env_file}")
sr_assert_file_contains("${env_file}" "EXIT_CODE=[0]")
sr_assert_file_contains("${env_file}" "PREPARE_EXIT_CODE=[0]")
sr_assert_file_contains("${env_file}" "RUNTIME_EXIT_CODE=[0]")
sr_assert_file_contains("${env_file}" "ABORTED_ON_RUNTIME_FAILURE=[false]")
sr_assert_file_contains("${env_file}" "EXECUTION_ID=[ctest-hook-success]")
sr_assert_file_contains("${env_file}" "OUTPUT_WRITE_FAILURES=[outputWriteFailures_0=[]]")
