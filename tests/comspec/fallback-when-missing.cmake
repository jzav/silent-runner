include("${SR_TESTS_SOURCE_DIR}/helpers/SRTest.cmake")
sr_test_init(DESCRIPTION "Uses the verified ComSpec fallback when ComSpec is absent or empty.")
sr_run(r UNSET_ENV ComSpec ARGS "${SR_OK}")
sr_assert_exit(r 0)
sr_assert_stdout_contains(r "${SR_TEST_CHILD_STDOUT_MARKER}")
sr_run(empty ENV "ComSpec=" ARGS "${SR_OK}")
sr_assert_exit(empty 0)
sr_assert_stdout_contains(empty "${SR_TEST_CHILD_STDOUT_MARKER}")
