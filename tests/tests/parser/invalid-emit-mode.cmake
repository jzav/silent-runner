include("${SR_TESTS_SOURCE_DIR}/helpers/SRTest.cmake")
sr_test_init(DESCRIPTION "Rejects invalid Headered and Raw parent emission modes.")
sr_run(r ARGS --stdout-emit invalid "${SR_OK}")
sr_assert_exit(r "${SR_TEST_EXIT_CLI_ERROR}")
sr_run(raw_stdout ARGS --stdout-emit-raw invalid "${SR_OK}")
sr_assert_exit(raw_stdout "${SR_TEST_EXIT_CLI_ERROR}")
sr_assert_stdout_empty(raw_stdout)
sr_run(raw_stderr ARGS --stderr-emit-child-raw invalid "${SR_OK}")
sr_assert_exit(raw_stderr "${SR_TEST_EXIT_CLI_ERROR}")
sr_assert_stdout_empty(raw_stderr)
