include("${SR_TESTS_SOURCE_DIR}/helpers/SRTest.cmake")
sr_test_init(DESCRIPTION "Rejects invalid question-mark characters in Headered and Raw child-stderr log directories.")
sr_run(r ARGS --stderr-dir-child "bad?path" "${SR_OK}")
sr_assert_exit(r "${SR_TEST_EXIT_CLI_ERROR}")
sr_run(raw ARGS --stderr-dir-child-raw "bad?path" "${SR_OK}")
sr_assert_exit(raw "${SR_TEST_EXIT_CLI_ERROR}")
sr_assert_stdout_empty(raw)
